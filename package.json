{
  "name": "mcp-card-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "TypeScript implementation of MCP Server Cards (SEP-2127)",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/*\" build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter=\"./packages/*\" typecheck",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Yunxiang Li <https://github.com/CUHK-AaronLi>",
  "repository": {
    "type": "git",
    "url": "https://github.com/CUHK-AaronLi/mcp-card.git"
  }
}
