{
  "name": "mcp-card-client",
  "version": "0.1.0",
  "description": "Fetch, validate, and discover MCP Server Cards (SEP-2127) from any URL",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "mcp-card-schema": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "keywords": ["mcp", "model-context-protocol", "sep-2127", "server-card", "client", "discovery"],
  "homepage": "https://github.com/CUHK-AaronLi/mcp-card",
  "repository": {
    "type": "git",
    "url": "https://github.com/CUHK-AaronLi/mcp-card.git",
    "directory": "packages/client"
  }
}
